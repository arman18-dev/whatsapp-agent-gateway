# Copy to .env (gitignored) and fill in. Never commit .env.

# From the WhatsApp app settings. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=change-me
# Any string you choose; enter the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=change-me-too

# mock = scripted model, zero cost (default). real = Claude Haiku 5.5, costs money.
LLM_MODE=mock
ANTHROPIC_API_KEY=
